:: StoryScript [script]
Macro.add('speech', {
    tags: null,
    handler: function () {
        var id = this.args[0], name = id.charAt(0).toUpperCase() + id.slice(1);
        if (this.args.length > 1) name = this.args[1];
        var output = '<div class="speech ' + id + '">';
        output += '<span class="avatar"></span>';
        output += '<div class="name">' + name + '</div><hr>';
        output += '<div class="text">' + this.payload[0].contents + '</div>';
        output += '</div><br>';
        $(this.output).wiki(output);
    }
});

/* Safe time-advance function – works in every SugarCube version */
window.advanceTime = function() {
    const order = ["early morning", "morning", "afternoon", "evening", "night"];
    const currentIndex = order.indexOf(State.variables.time);

    if (currentIndex === -1) return;                   // safety
    if (currentIndex + 1 >= order.length) {
        // It's already night → force player to bed
        Engine.play("Sleep");
    } else {
        State.variables.time = order[currentIndex + 1];
    }
};
window.placeMotherTrap = function(trapID, points, location) {
    State.variables.motherCorr += points;
    State.variables.motherTrapsUsed[trapID] = true;
   
    
    // optional: advance time after placing any trap
    // <<run advanceTime()>>
};
// <<i>> ... <</i>> for italic
Macro.add("i", {
    tags: null,
    handler: function () {
        $("<i/>").wiki(this.payload[0].contents).appendTo(this.output);
    }
});

// <<b>> ... <</b>> for bold (bonus, optional)
Macro.add("b", {
    tags: null,
    handler: function () {
        $("<b/>").wiki(this.payload[0].contents).appendTo(this.output);
    }
})

:: StoryStylesheet [stylesheet]
\:: StoryStylesheet
/* Core */
body, #story, #passages, .passage {
    background: #000 !important;
    color: #0ff !important;
    font-family: "IBM Plex Mono", "Courier New", monospace !important;
    font-size: 16px !important;
    line-height: 1.7 !important;
    letter-spacing: 0.5px;
}
#Prologue{   background: #000 !important;
    color: #0ff !important;
    font-family: "IBM Plex Mono", "Courier New", monospace !important;
    font-size: 16px !important;
    line-height: 1.7 !important;
    letter-spacing: 0.5px;
}

#passages {
    margin: 0 !important;
    padding: 40px 60px !important;}
#passages {
    margin: 0 !important;
    padding: 40px 60px !important;
}

#ui-bar {
    width: 280px !important;
    padding: 25px 20px !important;
    background: rgba(0,0,0,0.97) !important;
    border-right: 1px solid #0ff !important;
    box-shadow: 0 0 20px #0ff;
    font-size: 15px !important;
    line-height: 2.2 !important;
}

/* ALL LINKS → BOLD + NEON PINK */
a,
a.internalLink,
a.externalLink,
a.macro-link,
.passage a {
    color: #ff00ff !important;          /* bright magenta / hot pink */
    font-weight: bold !important;
    text-shadow: 0 0 12px #ff00ff !important;
    text-decoration: none !important;
}

a:hover,
a.internalLink:hover {
    color: #ff00ff !important;
    text-shadow: 0 0 25px #ff00ff, 0 0 35px #ff00ff !important;
}

/* Sidebar buttons stay cyan (so they don’t clash) */



button:hover {
    background: #0ff !important;
    color: #000 !important;
}

]

.speech {
    color: #fee;
    border: 2px solid #444;
    border-radius: 15px;
    padding: 20px;
    margin: 15px 0;
    box-shadow: 0 6px 12px rgba(0,0,0,0.8);
    max-width: 85%;
    position: relative;
    font-family: 'Georgia', serif;
    font-size: 1.1em;
    line-height: 1.5;
    background: linear-gradient(145deg, #333, #111);
}

.avatar {
    display: block;
    height: 90px;
    width: 90px;
    float: left;
    margin: 0 20px 10px 0;
    border: 3px solid #fee;
    border-radius: 50%;
    background-size: cover;
    background-position: center;
    box-shadow: 0 0 10px rgba(255,238,0,0.5);
}

.name {
    font-weight: bold;
    font-size: 1.4em;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 2px 2px 4px #000;
}

.text {
    clear: both;
    font-style: italic;
}

.speech::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 30px;
    width: 0;
    height: 0;
    border: 12px solid transparent;
    border-top-color: #333;
}

/* Character Styles - Left (victims) vs Right (you/Ryan) */
.father, .mother, .brother, .sister, .uncle, .aunt { margin-left: 0; margin-right: auto; }
.father::after, .mother::after, .brother::after, .sister::after, .uncle::after, .aunt::after { left: 30px; }

.ryan { background: linear-gradient(145deg, #8b0000, #ff0000); margin-left: auto; margin-right: 0; }
.ryan::after { left: auto; right: 30px; border-top-color: #8b0000; }
.ryan .avatar { background-image: url("img/ryan.png"); }

.victor { background: linear-gradient(145deg, #663300, #cc6600); }
