:: StoryScript [script]
Macro.add('speech', {
    tags: null,
    handler: function () {
        var id = this.args[0], name = id.charAt(0).toUpperCase() + id.slice(1);
        if (this.args.length > 1) name = this.args[1];
        var output = '<div class="speech ' + id + '">';
        output += '<span class="avatar"></span>';
        output += '<div class="name">' + name + '</div><hr>';
        output += '<div class="text">' + this.payload[0].contents + '</div>';
        output += '</div><br>';
        $(this.output).wiki(output);
    }
});

/* Safe time-advance function – works in every SugarCube version */
window.advanceTime = function() {
    const order = ["early morning", "morning", "afternoon", "evening", "night"];
    const currentIndex = order.indexOf(State.variables.time);

    if (currentIndex === -1) return;                   // safety
    if (currentIndex + 1 >= order.length) {
        // It's already night → force player to bed
        Engine.play("Sleep");
    } else {
        State.variables.time = order[currentIndex + 1];
    }
};
window.placeMotherTrap = function(trapID, points, location) {
    State.variables.motherCorr += points;
    State.variables.motherTrapsUsed[trapID] = true;
    State.variables.motherTrapsThisTier += 1;
    
    // advance tier when 3 traps of current tier are placed
    if (State.variables.motherTrapsThisTier >= 3 && State.variables.motherTier < 5) {
        State.variables.motherTier += 1;
        State.variables.motherTrapsThisTier = 0;
    }
    
    // optional: advance time after placing any trap
    // <<run advanceTime()>>
};

