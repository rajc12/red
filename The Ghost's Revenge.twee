    line-height: 1.7 !important;
    letter-spacing: 0.5px;
}

#passages {
    margin: 0 !important;
    padding: 40px 60px !important;}
#passages {
    margin: 0 !important;
    padding: 40px 60px !important;
}

#ui-bar {
    width: 280px !important;
    padding: 25px 20px !important;
    background: rgba(0,0,0,0.97) !important;
    border-right: 1px solid #0ff !important;
    box-shadow: 0 0 20px #0ff;
    font-size: 15px !important;
    line-height: 2.2 !important;
}

/* ALL LINKS → BOLD + NEON PINK */
a,
a.internalLink,
a.externalLink,
a.macro-link,
.passage a {
    color: #ff00ff !important;          /* bright magenta / hot pink */
    font-weight: bold !important;
    text-shadow: 0 0 12px #ff00ff !important;
    text-decoration: none !important;
}

a:hover,
a.internalLink:hover {
    color: #ff00ff !important;
    text-shadow: 0 0 25px #ff00ff, 0 0 35px #ff00ff !important;
}

/* Sidebar buttons stay cyan (so they don’t clash) */



button:hover {
    background: #0ff !important;
    color: #000 !important;
}

]

.speech {
    color: #fee;
    border: 2px solid #444;
    border-radius: 15px;
    padding: 20px;
    margin: 15px 0;
    box-shadow: 0 6px 12px rgba(0,0,0,0.8);
    max-width: 85%;
    position: relative;
    font-family: 'Georgia', serif;
    font-size: 1.1em;
    line-height: 1.5;
    background: linear-gradient(145deg, #333, #111);
}

.avatar {
    display: block;
    height: 90px;
    width: 90px;
    float: left;
    margin: 0 20px 10px 0;
    border: 3px solid #fee;
    border-radius: 50%;
    background-size: cover;
    background-position: center;
    box-shadow: 0 0 10px rgba(255,238,0,0.5);
}

.name {
    font-weight: bold;
    font-size: 1.4em;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-shadow: 2px 2px 4px #000;
}

.text {
    clear: both;
    font-style: italic;
}

.speech::after {
    content: '';
    position: absolute;
    bottom: -12px;
    left: 30px;
    width: 0;
    height: 0;
    border: 12px solid transparent;
    border-top-color: #333;
}

/* Character Styles - Left (victims) vs Right (you/Ryan) */
.father, .mother, .brother, .sister, .uncle, .aunt { margin-left: 0; margin-right: auto; }
.father::after, .mother::after, .brother::after, .sister::after, .uncle::after, .aunt::after { left: 30px; }

.ryan { background: linear-gradient(145deg, #8b0000, #ff0000); margin-left: auto; margin-right: 0; }
.ryan::after { left: auto; right: 30px; border-top-color: #8b0000; }
.ryan .avatar { background-image: url("img/ryan-possessed.png"); }

.father { background: linear-gradient(145deg, #663300, #cc6600); }
.father .avatar { background-image: url("img/father.png"); }

.mother { background: linear-gradient(145deg, #4b0082, #9932cc); }
.mother .avatar { background-image: url("img/mother.png"); }

.brother { background: linear-gradient(145deg, #ff69b4, #ff1493); }
.brother .avatar { background-image: url("img/brother.png"); }

.sister { background: linear-gradient(145deg, #ff4500, #ff6347); }
.sister .avatar { background-image: url("img/sister.png"); }

.uncle { background: linear-gradient(145deg, #daa520, #ffd700); }
.uncle .avatar { background-image: url("img/uncle.png"); }

