:: StoryScript [script]
Macro.add('speech', {
    tags: null,
    handler: function () {
        var id = this.args[0], name = id.charAt(0).toUpperCase() + id.slice(1);
        if (this.args.length > 1) name = this.args[1];
        var output = '<div class="speech ' + id + '">';
        output += '<span class="avatar"></span>';
        output += '<div class="name">' + name + '</div><hr>';
        output += '<div class="text">' + this.payload[0].contents + '</div>';
        output += '</div><br>';
        $(this.output).wiki(output);
    }
});
/* Safe time-advance function – works in every SugarCube version */
window.advanceTime = function() {
    const order = ["early morning", "morning", "afternoon", "evening", "night"];
    const currentIndex = order.indexOf(State.variables.time);
    if (currentIndex === -1) return;                   // safety
    if (currentIndex + 1 >= order.length) {
        // It's already night → force player to bed
        Engine.play("Sleep");
    } else {
        State.variables.time = order[currentIndex + 1];
    }
};
window.placeMotherTrap = function(trapID, points, location) {
    State.variables.motherCorr += points;
    State.variables.motherTrapsUsed[trapID] = true;
   
    
    // optional: advance time after placing any trap
    // <<run advanceTime()>>
};
// <<i>> ... <</i>> for italic
Macro.add("i", {
    tags: null,
    handler: function () {
        $("<i/>").wiki(this.payload[0].contents).appendTo(this.output);
    }
});
// <<b>> ... <</b>> for bold (bonus, optional)
Macro.add("b", {
    tags: null,
    handler: function () {
        $("<b/>").wiki(this.payload[0].contents).appendTo(this.output);
    }
})
window.placeFatherTrap = function(trapID, points) {
    State.variables.fatherCorr += points;
    State.variables.fatherTrapsUsed[trapID] = true;
    };
window.placeAuntTrap = function(trapID, points) {
    State.variables.auntCorr += points;
    State.variables.auntTrapsUsed[trapID] = true;
};
window.placeUncleTrap = function(trapID, points) {
    State.variables.uncleCorr += points;
    State.variables.uncleTrapsUsed[trapID] = true;
};
window.placeMeganTrap = function(trapID, points) {
    State.variables.broGFCorr += points;
    State.variables.brogfTrapsUsed[trapID] = true;
    
    /* Auto-unlock next quest when corruption hits multiple of 40 */
    if (State.variables.broGFCorr % 20 === 0 && 
        State.variables.broGFquestReady < (State.variables.broGFCorr / 20)) {
        State.variables.broGFquestReady = State.variables.broGFCorr / 20;
    }
};

/* ==== OFFICIAL SUGARCUBE SAVE MIGRATION ==== */
Config.saves.version = 2;   // ← Increment this every time you add new variables

Save.onLoad.add(function (save) {
    save.state.history.forEach(function (moment) {
        var v = moment.variables;
        var version = save.version || 0;   // old saves have no version → treat as 0

        /* -------------------------------------------------
           Version 1 → 2 : Add Aunt & Uncle + future characters
           ------------------------------------------------- */
        if (version < 2) {

            // === AUNT ===
            if (typeof v.auntTier === "undefined")        v.auntTier = 1;
            if (typeof v.auntCorr === "undefined")        v.auntCorr = 0;
            if (typeof v.auntQuestReady === "undefined")  v.auntQuestReady = 0;
            if (typeof v.auntTrapsUsed === "undefined")   v.auntTrapsUsed = {};

            // === UNCLE ===
            if (typeof v.uncleTier === "undefined")       v.uncleTier = 1;
            if (typeof v.uncleCorr === "undefined")       v.uncleCorr = 0;
            if (typeof v.uncleQuestReady === "undefined") v.uncleQuestReady = 0;
            if (typeof v.uncleTrapsUsed === "undefined")  v.uncleTrapsUsed = {};
            if (typeof v.uncleTrapsLocked === "undefined")v.uncleTrapsLocked = true;

            // === FUTURE CHARACTERS (safe defaults) ===
            if (typeof v.brotherTier === "undefined") v.brotherTier = 1;
            if (typeof v.brotherCorr === "undefined") v.brotherCorr = 0;
            if (typeof v.brotherQuestReady === "undefined") v.brotherQuestReady = 0;
            if (typeof v.brotherTrapsUsed === "undefined") v.brotherTrapsUsed = {};

            if (typeof v.sisterTier === "undefined")  v.sisterTier = 1;
            if (typeof v.sisterCorr === "undefined")  v.sisterCorr = 0;
            if (typeof v.sisterQuestReady === "undefined") v.sisterQuestReady = 0;
            if (typeof v.sisterTrapsUsed === "undefined")  v.sisterTrapsUsed = {};

            if (typeof v.broGFTier === "undefined") v.broGFTier = 1;
            if (typeof v.broGFCorr === "undefined") v.broGFCorr = 0;
            if (typeof v.sisBFTier === "undefined") v.sisBFTier = 1;
            if (typeof v.sisBFCorr === "undefined") v.sisBFCorr = 0;

